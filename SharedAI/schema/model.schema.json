{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "providerId",
        "providerModel",
        "displayName",
        "capabilities",
        "contextLimit",
        "roles"
      ],
      "properties": {
        "id": {
          "const": "nvidia-kimi-k3"
        },
        "providerId": {
          "const": "nvidia"
        },
        "providerModel": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9./-]{0,99}$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^(?!.*(?:[\\r\\n]|[Bb]earer |sk-|AIza|-----BEGIN)).+$"
        },
        "capabilities": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "text",
            "vision",
            "tools",
            "streaming",
            "structuredOutput"
          ],
          "properties": {
            "text": {
              "type": "boolean"
            },
            "vision": {
              "type": "boolean"
            },
            "tools": {
              "type": "boolean"
            },
            "streaming": {
              "type": "boolean"
            },
            "structuredOutput": {
              "type": "boolean"
            }
          }
        },
        "contextLimit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "general",
              "vision",
              "engineering",
              "agent",
              "fast",
              "fallback"
            ]
          }
        }
      }
    },
